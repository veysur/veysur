# Copy to `.env` and fill in. Never commit the real file.
# Only the keys below are read; anything else in `.env` is ignored.

# Image tag for veysur/api and veysur/nginx
VEYSUR_IMAGE_TAG=latest
# Registry + org prefix images are pulled from. Leave unset to use the published
# images at ghcr.io/veysur; point at a private registry for a custom build.
VEYSUR_IMAGE_REGISTRY=ghcr.io/veysur
# Host ports the front door (Caddy) publishes
VEYSUR_HTTP_PORT=80
VEYSUR_HTTPS_PORT=443

# TLS mode: which snippet Caddy loads. One of
#   ./caddy/tls-auto.caddy      Let's Encrypt for a public domain (default)
#   ./caddy/tls-custom.caddy    your own cert in deploy/certs/tls.crt and tls.key
#   ./caddy/tls-internal.caddy  Caddy's local CA, for local trials
#   ./caddy/tls-none.caddy      behind a TLS-terminating proxy; also set VEYSUR_SITE_ADDRESS=:80
VEYSUR_TLS_SNIPPET=./caddy/tls-auto.caddy
# Contact address for Let's Encrypt (required for tls-auto)
VEYSUR_ACME_EMAIL=
# Defaults to API_WEB_DOMAIN
VEYSUR_SITE_ADDRESS=

# Public domain the install is served from (no scheme)
API_WEB_DOMAIN=veysur.example.com
API_DOMAIN=veysur.example.com
API_CORS_ALLOWED_DOMAINS=veysur.example.com
# Public base URL used to build file links
API_S3_PUBLIC_BASE_URL=https://veysur.example.com
API_BRAND_NAME=VeySur

# File storage. `local` keeps files in the veysur-files Docker volume. `s3` uses
# an S3-compatible service and needs everything below it; config-generate.sh
# fills these in and writes nginx/storage-s3.conf. See docs/storage.md.
API_S3_TYPE=local
VEYSUR_STORAGE_SNIPPET=./nginx/storage-local.conf
# S3 only. The endpoint is a bare origin with no trailing slash, for example
# https://s3.eu-west-2.amazonaws.com or http://minio:9000
API_S3_ENDPOINT=
API_S3_REGION=us-east-1
API_S3_FORCE_PATH_STYLE=true
API_S3_PUBLIC_BUCKET=veysur-files
API_S3_PRIVATE_BUCKET=veysur-private
API_S3_ACCESS_KEY_ID=
API_S3_SECRET_ACCESS_KEY=

# Administrator e-mail; the first-account bootstrap script uses it
VEYSUR_ADMIN_EMAIL=
# Set by the first-account bootstrap script; do not edit by hand
API_PROJECT_OWNER_ID=

# Secrets. Generate long random values; the operator scripts do this for you.
API_JWT_KEY=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
API_S3_LOCAL_SECRET=
API_ENCRYPTION_PUBLIC_KEY=
API_ENCRYPTION_PRIVATE_KEY=
API_ENCRYPTION_PRIVATE_KEY_PASSWORD=

# Database names and user (defaults shown)
MYSQL_DATABASE=veysurAccount
MYSQL_DATABASE_IP_LOCATION=veysurIpLocation
MYSQL_USER=veysur

# MySQL container memory limit and InnoDB buffer pool, in MB. Blank lets
# config-generate.sh size these from detected host RAM (floor 1250/512,
# unchanged from a minimal ~3 GB install); set explicitly to override.
MYSQL_MEMORY_LIMIT_MB=
MYSQL_BUFFER_POOL_MB=

# Outbound mail: an SMTP relay you run or rent. Left blank, mail fails loudly.
# Port 587 upgrades with STARTTLS (SECURE=false); port 465 needs SECURE=true.
# See docs/email.md.
API_MAIL_HOST=
API_MAIL_PORT=587
API_MAIL_TRANSPORT_TYPE=smtp
API_MAIL_SECURE=false
API_MAIL_CANARY_TO=
API_MAIL_AUTH_USER=
API_MAIL_AUTH_PASS=
# Sender identity. Blank uses no-reply@<API_WEB_DOMAIN> and API_BRAND_NAME.
# Your relay must be allowed to send as this address.
API_MAIL_ADDRESS_FROM=
API_MAIL_FROM_NAME=
API_MAIL_ADDRESS_CONTACT=
# Name used in e-mails when the project has no name of its own (default MyCompany)
API_COMPANY_NAME=

# Optional bounce and complaint processing over IMAP. Blank disables it.
API_MAIL_BOUNCE_DOMAIN=
API_MAIL_IMAP_HOST=
API_MAIL_IMAP_PORT=993
API_MAIL_IMAP_BOUNCE_USER=
API_MAIL_IMAP_BOUNCE_PASS=
API_MAIL_IMAP_ABUSE_USER=
API_MAIL_IMAP_ABUSE_PASS=
API_MAIL_IMAP_CA_CERT=
