# Copy to `.env` and fill in. Never commit the real file.
# Only the keys below are read; anything else in `.env` is ignored.

# Image tag for veysur/api and veysur/nginx
VEYSUR_IMAGE_TAG=latest
# Host port nginx publishes
VEYSUR_HTTP_PORT=80

# Public domain the install is served from (no scheme)
API_WEB_DOMAIN=veysur.example.com
API_DOMAIN=veysur.example.com
API_CORS_ALLOWED_DOMAINS=veysur.example.com
# Public base URL used to build file links
API_S3_PUBLIC_BASE_URL=https://veysur.example.com
API_BRAND_NAME=VeySur

# Id printed by the admin account bootstrap task, set after first install
API_PROJECT_OWNER_ID=

# Secrets. Generate long random values; the operator scripts do this for you.
API_JWT_KEY=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
API_S3_LOCAL_SECRET=
API_ENCRYPTION_PUBLIC_KEY=
API_ENCRYPTION_PRIVATE_KEY=
API_ENCRYPTION_PRIVATE_KEY_PASSWORD=

# Database names and user (defaults shown)
MYSQL_DATABASE=veysurAccount
MYSQL_DATABASE_IP_LOCATION=veysurIpLocation
MYSQL_USER=veysur

# Outbound mail: an SMTP relay you run or rent. Left blank, mail fails loudly.
API_MAIL_HOST=
API_MAIL_PORT=587
API_MAIL_TRANSPORT_TYPE=smtp
API_MAIL_SECURE=false
API_MAIL_CANARY_TO=
API_MAIL_AUTH_USER=
API_MAIL_AUTH_PASS=
