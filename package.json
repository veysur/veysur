{
  "name": "veysur",
  "version": "0.9.0",
  "private": true,
  "description": "VeySur - self-hostable survey platform",
  "license": "Elastic-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "docker compose --project-directory deploy -f deploy/compose.yaml -f deploy/compose.dev.yaml watch",
    "down": "./deploy/scripts/down.sh",
    "test:storage": "./deploy/tests/storage-s3.e2e.sh",
    "dev:admin-account": "./deploy/scripts/admin-account-bootstrap.sh",
    "dev:task": "./deploy/scripts/task-run.sh",
    "dev:migrate": "docker compose --project-directory deploy -f deploy/compose.yaml -f deploy/compose.dev.yaml run --rm migrate",
    "dev:api": "pnpm --filter veysur-api start",
    "dev:admin": "pnpm --filter veysur-app devAdmin",
    "dev:survey": "pnpm --filter veysur-app devSurvey",
    "dev:account": "pnpm --filter veysur-app devAccount:selfhosted",
    "dev:docsite": "pnpm --filter veysur-docsite dev",
    "build": "pnpm -r build",
    "build:common": "pnpm --filter veysur-common build",
    "build:api": "pnpm --filter veysur-api build",
    "build:app": "pnpm --filter veysur-app build",
    "build:docsite": "pnpm --filter veysur-docsite build",
    "test": "pnpm -r test",
    "test:app": "pnpm --filter veysur-app test",
    "test:api": "pnpm --filter veysur-api test",
    "test:common": "pnpm --filter veysur-common test",
    "lint": "pnpm -r lint && ./scripts/check-no-billing-logic.sh",
    "license-check": "pnpm --filter veysur-api --filter veysur-app --filter veysur-common run license-checker",
    "license-notices": "node scripts/license-notices.mjs",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules && rm -rf package/*/dist package/*/build",
    "clean:dist": "rm -rf package/*/dist package/*/build",
    "commit": "cz",
    "changeset": "changeset",
    "prepare": "git config core.hooksPath .githooks && git config commit.template .git-commit-template.txt"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cspell/dict-node": "^5.0.9",
    "@cspell/dict-npm": "^5.2.50",
    "@cspell/dict-software-terms": "^5.4.5",
    "@cspell/dict-typescript": "^3.2.3",
    "commitizen": "^4.3.2",
    "cspell": "^9.8.0",
    "cz-customizable": "^7.5.4",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
