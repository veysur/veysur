---
// A static file in public/specs/, served by the same nginx as the docs, so the link is
// same-origin in every deployment.
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const href = `${base}/specs/survey-markdown-format.md`
---

<a href={href} download="veysur-survey-markdown-spec.md"><slot /></a>
