{
  "name": "veysur-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./*.ts": "./src/*.ts",
    "./*.tsx": "./src/*.tsx"
  },
  "scripts": {
    "generate-cloud-composition": "node scripts/generate-cloud-composition.mjs",
    "predev": "pnpm run generate-cloud-composition",
    "prebuild": "pnpm run generate-cloud-composition",
    "prebuildAdmin": "pnpm run generate-cloud-composition",
    "predevAdmin": "pnpm run generate-cloud-composition",
    "prebuildAccount": "pnpm run generate-cloud-composition",
    "predevAccount": "pnpm run generate-cloud-composition",
    "prebuildAccount:selfhosted": "PUBLIC_EDITION=self-hosted pnpm run generate-cloud-composition",
    "predevAccount:selfhosted": "PUBLIC_EDITION=self-hosted pnpm run generate-cloud-composition",
    "pretypecheck": "pnpm run generate-cloud-composition",
    "pretypecheck:selfhosted": "PUBLIC_EDITION=self-hosted pnpm run generate-cloud-composition",
    "build": "rm -rf dist && rsbuild build",
    "buildAdmin": "rsbuild build --config rsbuild.admin.config.ts",
    "buildSurvey": "rsbuild build --config rsbuild.survey.config.ts",
    "buildAccount": "rsbuild build --config rsbuild.account.config.ts",
    "buildAccount:selfhosted": "PUBLIC_EDITION=self-hosted rsbuild build --config rsbuild.account.config.ts",
    "dev": "rsbuild dev --open",
    "devAdmin": "rsbuild dev --open --config rsbuild.admin.config.ts",
    "devSurvey": "rsbuild dev --open --config rsbuild.survey.config.ts",
    "devAccount": "rsbuild dev --open --config rsbuild.account.config.ts",
    "devAccount:selfhosted": "PUBLIC_EDITION=self-hosted rsbuild dev --open --config rsbuild.account.config.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "rsbuild preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:selfhosted": "tsc --noEmit -p tsconfig.selfhosted.json",
    "license-checker": "license-checker-rseidelsohn --production --onlyAllow \"MIT;ISC;BSD;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Unlicense;WTFPL;Python-2.0;BlueOak-1.0.0;(MIT OR EUPL-1.1+);(MIT AND ISC);(MIT AND Zlib);(MPL-2.0 OR Apache-2.0);(Apache-2.0 AND BSD-3-Clause);MIT*;UNLICENSED;UNKNOWN\""
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.10",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.53.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@types/js-beautify": "^1.14.3",
    "@types/qrcode.react": "^3.0.0",
    "@uiw/react-codemirror": "^4.25.2",
    "axios": "1.18.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.11",
    "i18next": "^26.3.6",
    "i18next-http-backend": "^4.0.0",
    "js-beautify": "^1.15.4",
    "lucide-react": "^1.25.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.2",
    "mzen-id": "workspace:*",
    "mzen-schema": "workspace:*",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-advanced-cropper": "^0.20.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.13.2",
    "react-virtuoso": "^4.14.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "0.9.0",
    "tw-animate-css": "^1.4.0",
    "veysur-common": "workspace:*",
    "veysur-theme": "workspace:*",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^1.7.4",
    "@rsbuild/plugin-react": "^1.4.1",
    "@rsbuild/plugin-sass": "^1.4.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.11",
    "@types/react-router-dom": "^5.3.3",
    "license-checker-rseidelsohn": "^5.0.1",
    "eslint": "^10.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "^17.4.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.8.1",
    "sass": "^1.99.0",
    "source-map": "0.8.0-beta.0",
    "source-map-generator": "^2.0.6",
    "tailwindcss": "^4.0.9",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.62.1",
    "webpack-bundle-analyzer": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "fakeTimers": {
      "enableGlobally": true
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.{ts,tsx}"
    ],
    "modulePaths": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^p-limit$": "<rootDir>/../../../../node_modules/.pnpm/p-limit@3.1.0/node_modules/p-limit/index.js",
      "^ansi-regex$": "<rootDir>/../../../../node_modules/.pnpm/ansi-regex@5.0.1/node_modules/ansi-regex/index.js",
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "^.+\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/tests/mocks/fileMock.ts",
      "^.+\\.(css|less|scss|sass)$": "<rootDir>/tests/mocks/styleMock.ts",
      "(assets|models|services)": "<rootDir>/tests/mocks/fileMock.ts"
    },
    "transform": {
      ".*\\.(ts|tsx)$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/.+$"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setupTests.ts"
    ],
    "testEnvironmentOptions": {
      "errorOnUnhandledPromises": false
    }
  }
}
