    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.15",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "0.9.0",
    "tw-animate-css": "^1.4.0",
    "veysur-common": "workspace:*",
    "veysur-theme": "workspace:*",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-react": "^1.4.6",
    "@rsbuild/plugin-sass": "^1.5.3",
    "@tailwindcss/postcss": "^4.3.3",
