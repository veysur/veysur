{
  "name": "veysur-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.ts": "./src/*.ts",
    "./*.tsx": "./src/*.tsx"
  },
  "scripts": {
    "generate-cloud-composition": "node scripts/generate-cloud-composition.mjs",
    "predev": "pnpm run generate-cloud-composition",
    "prebuild": "pnpm run generate-cloud-composition",
    "prebuildAdmin": "pnpm run generate-cloud-composition",
    "predevAdmin": "pnpm run generate-cloud-composition",
    "prebuildAccount": "pnpm run generate-cloud-composition",
    "predevAccount": "pnpm run generate-cloud-composition",
    "prebuildAccount:selfhosted": "PUBLIC_EDITION=self-hosted pnpm run generate-cloud-composition",
    "predevAccount:selfhosted": "PUBLIC_EDITION=self-hosted pnpm run generate-cloud-composition",
    "pretypecheck": "pnpm run generate-cloud-composition",
    "pretypecheck:selfhosted": "PUBLIC_EDITION=self-hosted pnpm run generate-cloud-composition",
    "build": "rm -rf dist && rsbuild build",
    "buildAdmin": "rsbuild build --config rsbuild.admin.config.ts",
    "buildSurvey": "rsbuild build --config rsbuild.survey.config.ts",
    "buildAccount": "rsbuild build --config rsbuild.account.config.ts",
    "buildAccount:selfhosted": "PUBLIC_EDITION=self-hosted rsbuild build --config rsbuild.account.config.ts",
    "dev": "rsbuild dev --open",
    "devAdmin": "rsbuild dev --open --config rsbuild.admin.config.ts",
    "devSurvey": "rsbuild dev --open --config rsbuild.survey.config.ts",
    "devAccount": "rsbuild dev --open --config rsbuild.account.config.ts",
    "devAccount:selfhosted": "PUBLIC_EDITION=self-hosted rsbuild dev --open --config rsbuild.account.config.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "rsbuild preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:selfhosted": "tsc --noEmit -p tsconfig.selfhosted.json",
    "license-checker": "license-checker-rseidelsohn --production --onlyAllow \"MIT;ISC;BSD;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Unlicense;WTFPL;Python-2.0;BlueOak-1.0.0;(MIT OR EUPL-1.1+);(MIT AND ISC);(MIT AND Zlib);(MPL-2.0 OR Apache-2.0);(Apache-2.0 AND BSD-3-Clause);MIT*;UNLICENSED;UNKNOWN\""
  },
