# cspell:disable
# Used when running `pnpm dev` locally.
# In Tilt/k8s, set values in values-tilt.yaml instead.

# Site access gate — leave empty to allow unrestricted access.
# Set to a secret key to require visitors to supply ?access_key=<key> in the URL before they
# can use the app. Useful for stage, pre-launch, or maintenance deployments.
# Rotate the key (redeploy) to invalidate existing access cookies.
PUBLIC_SITE_ACCESS_KEY=
# PUBLIC_SITE_UNAVAILABLE_TITLE=Site Unavailable
# PUBLIC_SITE_UNAVAILABLE_MESSAGE=This site is not available at this time.

PUBLIC_AUTHENTICATION_DOMAIN=account.veysur.local
PUBLIC_AUTHENTICATION_BYPASS_DOMAINS=localhost:3000,127.0.0.1:3000
PUBLIC_APP_DOMAIN=veysur.local
