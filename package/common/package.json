{
  "name": "veysur-common",
  "version": "0.2.0",
  "description": "",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "model/constructor": [
        "./dist/cjs/model/constructor/index.d.ts"
      ],
      "model/schema": [
        "./dist/cjs/model/schema/index.d.ts"
      ],
      "util/generateSurveyHash": [
        "./dist/cjs/util/generateSurveyHash.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    },
    "./model/constructor": {
      "import": "./dist/esm/model/constructor/index.js",
      "require": "./dist/cjs/model/constructor/index.js",
      "types": "./dist/cjs/model/constructor/index.d.ts"
    },
    "./model/schema": {
      "import": "./dist/esm/model/schema/index.js",
      "require": "./dist/cjs/model/schema/index.js",
      "types": "./dist/cjs/model/schema/index.d.ts"
    },
    "./util/generateSurveyHash": {
      "import": "./dist/esm/util/generateSurveyHash.js",
      "require": "./dist/cjs/util/generateSurveyHash.js",
      "types": "./dist/cjs/util/generateSurveyHash.d.ts"
    }
  },
  "scripts": {
    "build": "sh build.sh",
    "format": "prettier --write ./src",
    "clean": "rm -fr ./dist ./dist.new ./dist.old",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "license-checker": "license-checker-rseidelsohn --production --onlyAllow \"MIT;ISC;BSD;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Unlicense;WTFPL;Python-2.0;BlueOak-1.0.0;(MIT OR EUPL-1.1+);(MIT AND ISC);(MIT AND Zlib);(MPL-2.0 OR Apache-2.0);(Apache-2.0 AND BSD-3-Clause);MIT*;UNLICENSED;UNKNOWN\""
  },
  "keywords": [],
  "author": "",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "bson-objectid": "^2.0.4",
    "jsep": "^1.4.0",
    "markdown-it": "^14.3.2",
    "moment-timezone": "^0.6.4",
    "@datacapy/id": "workspace:*",
    "@datacapy/schema": "workspace:*",
    "sanitize-html": "2.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "tsc-alias": "1.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "files": [
    "/dist/*"
  ]
}
