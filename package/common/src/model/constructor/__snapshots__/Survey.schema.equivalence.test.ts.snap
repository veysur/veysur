            "required": true,
          },
        },
        "updatedAt": {
          "$filter": {
            "defaultValue": "now",
          },
          "$type": "$fn:Date",
        },
      },
      "$type": "$fn:Array",
    },
    "stats": {
      "$type": "$fn:Object",
      "questions": {
        "$type": "$fn:Object",
        "*": {
          "$type": "$fn:Object",
          "chartType": {
            "$type": "$fn:String",
            "$validate": {
              "inArray": {
                "values": [
                  "bar",
                  "horizontalBar",
                  "pie",
                  "stackedBar",
                  "pieGrid",
                  "averageRank",
                ],
              },
            },
          },
          "valueMode": {
            "$type": "$fn:String",
            "$validate": {
              "inArray": {
                "values": [
                  "count",
                  "percentage",
                ],
              },
            },
          },
        },
      },
    },
    "thankYou": {
      "$type": "$fn:Object",
      "link": {
        "$type": "$fn:Object",
        "text": {
          "$construct": "L10n",
          "$name": "l10n",
          "$strict": true,
          "*": {
            "$filter": {
              "stripHtml": true,
              "trim": true,
            },
            "$type": "$fn:String",
            "$validate": {
              "valueLength": {
                "max": 100000,
              },
            },
          },
        },
        "url": {
          "$construct": "L10n",
          "$name": "l10nUrl",
          "$strict": true,
          "*": {
            "$filter": {
              "prependHttp": {
                "$if": {
                  "$not": {
                    "$regex": "$re:/^[a-zA-Z][a-zA-Z\\d+\\-.]*:/",
                  },
                },
              },
              "stripHtml": true,
              "trim": true,
            },
            "$type": "$fn:String",
            "$validate": {
              "regex": {
                "message": "url must use the http or https scheme",
                "pattern": "$re:/^(https?:\\/\\/\\S+)?$/i",
              },
              "valueLength": {
                "max": 100000,
              },
            },
          },
        },
      },
      "message": {
        "$construct": "L10n",
        "$name": "l10nHtml",
        "$strict": true,
        "*": {
          "$filter": {
            "trim": true,
          },
          "$type": "$fn:String",
          "$validate": {
            "valueLength": {
              "max": 100000,
            },
          },
        },
      },
    },
    "title": {
      "$construct": "L10n",
      "$filter": {
        "defaultValue": {},
      },
      "$type": "$fn:Object",
      "*": {
        "$filter": {
          "stripHtml": true,
          "trim": true,
        },
        "$label": "Title",
        "$type": "$fn:String",
        "$validate": {
          "valueLength": {
            "max": 255,
          },
        },
      },
    },
    "updatedAt": {
      "$filter": {
        "defaultValue": "now",
      },
      "$type": "$fn:Date",
    },
    "welcome": {
      "$type": "$fn:Object",
      "message": {
        "$construct": "L10n",
        "$name": "l10nHtml",
        "$strict": true,
        "*": {
          "$filter": {
            "trim": true,
          },
          "$type": "$fn:String",
          "$validate": {
            "valueLength": {
              "max": 100000,
            },
          },
        },
      },
    },
  },
  "unknownKey": {
    "ok": true,
    "result": {
      "errors": {
        "$unknown": [
          "Field not specified",
        ],
      },
      "isValid": false,
    },
  },
  "valid": {
    "ok": true,
    "result": {
      "errors": {},
      "isValid": true,
    },
  },
}
`;
