# cspell:disable
API_JWT_KEY="REDACTED-DEV-JWT-KEY"

# Deployment mode: use "self-hosted". Any other value selects a mode this repo does not support.
# DEPLOYMENT_MODE=cloud

# Optional: path (resolved relative to model-manager.ts) to a module whose default
# export is a ModelComposition to merge into core's model. Leave unset.
# API_COMPOSITION_MODULE=../../../../../package/api-cloud/dist/index

# JWT lifetimes / TTLs (seconds)
# API_JWT_PARTICIPANT_LIFETIME_SECONDS=10800
# API_JWT_ADMIN_LIFETIME_SECONDS=600
# API_JWT_ACCESS_TOKEN_TTL_SECONDS=15552000
# API_JWT_PRE_AUTH_TTL_SECONDS=300

# Bcrypt salt rounds for password hashing (default 12)
# API_BCRYPT_SALT_ROUNDS=12

# Token TTLs (seconds)
# API_PASSWORD_RESET_TOKEN_TTL_SECONDS=5400
# API_EMAIL_VERIFY_TOKEN_TTL_SECONDS=172800

# Email suppression expiry (days) - complaint/unsubscribe are always permanent
# API_EMAIL_SUPPRESSION_HARD_BOUNCE_EXPIRY_DAYS=30
# API_EMAIL_SUPPRESSION_SOFT_BOUNCE_EXPIRY_DAYS=2

# Limits
# API_UPLOAD_MAX_FILE_SIZE=104857600
# API_PAGINATION_MAX_PER_PAGE=100

API_MAIL_ADDRESS_CONTACT=hello@veysur.com
API_MAIL_FROM_NAME=VeySur

# Plain product brand name — shown in non-legal contexts (e.g. 2FA QR issuer)
API_BRAND_NAME=VeySur

# Company name — shown in emails and legal notices
API_COMPANY_NAME=VeySur Limited

# Sendmail transport (fallback, used when not sending via SMTP)
# API_MAIL_SENDMAIL_PATH=/usr/sbin/sendmail
# API_MAIL_SENDMAIL_NEWLINE=unix

# Bulk mail queue pacing — rows dispatched per processQueue run (see docs/mail-queue-pacing.md)
# API_MAIL_QUEUE_PROCESS_BATCH_SIZE=200

# Override geo country detection for local dev (e.g. GEO_COUNTRY_OVERRIDE=US)
# GEO_COUNTRY_OVERRIDE=

# Comma-separated ISO 3166-1 alpha-2 country codes blocked from using the
# service (no local legal representation) — see docs/country-blocking.md
# BLOCKED_COUNTRIES=CH,TR

MYSQL_HOST="localhost"
MYSQL_USER="root"
MYSQL_PASSWORD="REDACTED-DEV-DB-PASSWORD"
MYSQL_DATABASE="veysur"
MYSQL_DATABASE_IP_LOCATION="veysurIpLocation"