{
  "name": "veysur-api",
  "version": "0.2.0",
  "description": "",
  "main": "index.js",
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && pnpm run copy-assets",
    "build:dev": "tsc -p tsconfig.build.json --incremental && tsc-alias -p tsconfig.build.json && pnpm run copy-assets",
    "copy-assets": "mkdir -p dist/model/asset && cp -r src/model/asset/* dist/model/asset/ && mkdir -p dist/locale && cp -r src/locale/* dist/locale/",
    "format": "prettier --write ./src",
    "clean": "rm -fr ./dist/*",
    "start": "./script/start.sh",
    "start-background": "node dist/run.js &",
    "migrate": "MYSQL_ENSURE_DATABASE=true node dist/script/migrate.js",
    "migrate:dry-run": "MYSQL_ENSURE_DATABASE=true node dist/script/migrate.js --dry-run",
    "test": "./script/test.sh --passWithNoTests",
    "test:watch": "./script/test.sh --watch",
    "test:integration": "./script/test-integration.sh",
    "test:integration:down": "docker compose -f docker-compose.test.yml down",
    "test:all": "pnpm test && pnpm test:integration",
    "typecheck": "tsc --noEmit",
    "typecheck:selfhosted": "DEPLOYMENT_MODE=self-hosted tsc -p tsconfig.selfhosted.json --noEmit",
    "build:selfhosted": "pnpm run clean && DEPLOYMENT_MODE=self-hosted tsc -p tsconfig.selfhosted.json && tsc-alias -p tsconfig.selfhosted.json && pnpm run copy-assets",
    "lint": "eslint .",
    "license-checker": "license-checker-rseidelsohn --production --onlyAllow \"MIT;ISC;BSD;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Unlicense;WTFPL;Python-2.0;BlueOak-1.0.0;(MIT OR EUPL-1.1+);(MIT AND ISC);(MIT AND Zlib);(MPL-2.0 OR Apache-2.0);(Apache-2.0 AND BSD-3-Clause);MIT*;UNLICENSED;UNKNOWN\""
  },
  "keywords": [],
  "author": "Kevin Foster",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@sentry/node": "^10.75.3",
    "@types/mailparser": "^3.9.0",
    "bcryptjs": "^3.0.3",
    "fast-xml-parser": "^5.11.2",
    "formidable": "^3.5.4",
    "handlebars": "^4.7.9",
    "html-to-text": "^10.0.1",
    "i18next": "^26.4.2",
    "imapflow": "^2.1.2",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.31",
    "moment-timezone": "^0.6.4",
    "@datacapy/id": "workspace:*",
    "@datacapy/migrate": "workspace:*",
    "@datacapy/om": "workspace:*",
    "@datacapy/schema": "workspace:*",
    "@datacapy/server": "workspace:*",
    "node-dir": "^0.1.17",
    "nodemailer": "^9.1.1",
    "otpauth": "^9.5.2",
    "papaparse": "^5.7.0",
    "path": "^0.12.7",
    "pdfkit": "^0.19.1",
    "s3-adaptor": "workspace:*",
    "tar-stream": "^3.2.1",
    "util": "^0.12.5",
    "veysur-common": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.8",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/tar-stream": "^3.1.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-jasmine2": "^30.5.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "tsc-alias": "1.9.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
