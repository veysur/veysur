{
  "name": "veysur-api",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && pnpm run copy-assets",
    "build:dev": "tsc -p tsconfig.build.json --incremental && tsc-alias -p tsconfig.build.json && pnpm run copy-assets",
    "copy-assets": "mkdir -p dist/model/asset && cp -r src/model/asset/* dist/model/asset/ && mkdir -p dist/locale && cp -r src/locale/* dist/locale/",
    "format": "prettier --write ./src",
    "clean": "rm -fr ./dist/*",
    "start": "./script/start.sh",
    "start-background": "node dist/run.js &",
    "migrate": "MYSQL_ENSURE_DATABASE=true node dist/script/migrate.js",
    "migrate:dry-run": "MYSQL_ENSURE_DATABASE=true node dist/script/migrate.js --dry-run",
    "seed:e2e": "node dist/script/seed-e2e.js",
    "test": "./script/test.sh --passWithNoTests",
    "test:watch": "./script/test.sh --watch",
    "test:integration": "./script/test-integration.sh",
    "test:integration:down": "docker compose -f docker-compose.test.yml down",
    "test:all": "pnpm test && pnpm test:integration",
    "typecheck": "tsc --noEmit",
    "typecheck:selfhosted": "DEPLOYMENT_MODE=self-hosted tsc -p tsconfig.selfhosted.json --noEmit",
    "build:selfhosted": "pnpm run clean && DEPLOYMENT_MODE=self-hosted tsc -p tsconfig.selfhosted.json && tsc-alias -p tsconfig.selfhosted.json && pnpm run copy-assets",
    "lint": "eslint .",
    "license-checker": "license-checker-rseidelsohn --production --onlyAllow \"MIT;ISC;BSD;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Unlicense;WTFPL;Python-2.0;BlueOak-1.0.0;(MIT OR EUPL-1.1+);(MIT AND ISC);(MIT AND Zlib);(MPL-2.0 OR Apache-2.0);(Apache-2.0 AND BSD-3-Clause);MIT*;UNLICENSED;UNKNOWN\""
  },
  "keywords": [],
  "author": "Kevin Foster",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@sentry/node": "^10.53.1",
    "@types/mailparser": "^3.4.6",
    "bcryptjs": "^3.0.3",
    "fast-xml-parser": "^5.10.1",
    "formidable": "^3.5.4",
    "handlebars": "^4.7.9",
    "html-to-text": "^10.0.0",
    "i18next": "^26.3.6",
    "imapflow": "^1.3.3",
    "ioredis": "^5.10.1",
    "ipaddr.js": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.15",
    "moment-timezone": "^0.6.2",
    "mzen-id": "workspace:*",
    "mzen-migrate": "workspace:*",
    "mzen-om": "workspace:*",
    "mzen-schema": "workspace:*",
    "mzen-server": "workspace:*",
    "node-dir": "^0.1.17",
    "nodemailer": "^9.0.1",
    "otpauth": "^9.5.1",
    "papaparse": "^5.5.3",
    "path": "^0.12.7",
    "pdfkit": "^0.19.1",
    "s3-adaptor": "workspace:*",
    "stripe": "^22.3.1",
    "tar-stream": "^3.2.0",
    "util": "^0.12.5",
    "veysur-common": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "@types/papaparse": "^5.5.0",
    "@types/pdfkit": "^0.17.6",
    "@types/tar-stream": "^3.1.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jest": "^30.4.2",
    "jest-jasmine2": "^30.3.0",
    "prettier": "^3.9.4",
    "ts-jest": "^29.4.9",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.62.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "fakeTimers": {
      "enableGlobally": true
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.{ts,tsx}",
      "<rootDir>/test/**/*.test.{ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.test\\.ts$"
    ],
    "moduleDirectories": [
      "<rootDir>/src/",
      "<rootDir>/node_modules/"
    ],
    "transform": {
      ".*\\.(ts|tsx)$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/.+$"
    ],
    "moduleNameMapper": {
      "^pretty-format$": "<rootDir>/../../../../node_modules/.pnpm/pretty-format@29.7.0/node_modules/pretty-format/build/index.js",
      "^p-limit$": "<rootDir>/../../../../node_modules/.pnpm/p-limit@3.1.0/node_modules/p-limit/index.js",
      "^ansi-regex$": "<rootDir>/../../../../node_modules/.pnpm/ansi-regex@5.0.1/node_modules/ansi-regex/index.js",
      "^entities/decode$": "<rootDir>/../../../../node_modules/.pnpm/entities@7.0.1/node_modules/entities/dist/commonjs/decode.js",
      "^entities$": "<rootDir>/../../../../node_modules/.pnpm/entities@7.0.1/node_modules/entities/dist/commonjs/index.js",
      "^@noble/hashes/(.*)$": "<rootDir>/../../../../node_modules/.pnpm/@noble+hashes@1.8.0/node_modules/@noble/hashes/$1.js",
      "^@noble/ciphers/(.*)$": "<rootDir>/../../../../node_modules/.pnpm/@noble+ciphers@1.3.0/node_modules/@noble/ciphers/$1.js",
      "^jest-util$": "<rootDir>/../../node_modules/.pnpm/jest-util@30.5.1/node_modules/jest-util/build/index.js"
    }
  }
}
